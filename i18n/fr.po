#. module: loyalty_reminder
#: model:ir.model.fields,help:loyalty_reminder.field_loyalty_card_reminder_line__active
msgid ""
"Automatically unchecked once the reminder has been sent (duplicate guard) "
"- mostly a display status, the card and its lines are kept."
msgstr ""
"Décoché automatiquement une fois le rappel envoyé (anti-doublon) - sert "
"surtout à l'affichage, la carte et ses lignes restent conservées."

