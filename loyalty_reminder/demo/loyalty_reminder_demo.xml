<odoo>

    <!--
        DEMO DATA OF loyalty_reminder.

        This module declares `loyalty` as its only dependency (see the spec: it must stay
        usable without loyalty_expiration_management, hence without sale_loyalty). It can
        therefore NOT reference the xml_ids of the family pivot published by the socle
        loyalty_expiration_management: an Odoo XML `ref()` is hard, and the demo load order
        follows the dependency graph, so those identifiers may simply not exist yet when
        this file loads. Everything below leans on the demo of the core instead:

          - the program the reminders are configured on is the core program
            `loyalty.3_cabinets_plus_1_free`, extended by external reference. No new
            `loyalty.program` is created here, so nothing can shadow or duplicate the
            family pivot when both modules are installed.
          - the card holders are the core demo contacts `base.res_partner_address_*`,
            which carry an email address, so an actual reminder has somewhere to go.

        The set is built so the module's own behaviour is legible in the UI without any
        manipulation: one card whose reminder has already been sent (muted line + chatter
        trace), one card that the next cron pass will remind, one card-level override, and
        the two cases that must never trigger (no expiry date, exhausted and expired).

        `loyalty.3_cabinets_plus_1_free` is chosen over the more obvious coupon program
        `loyalty.10_percent_coupon` because that one carries a `create`-triggered
        communication plan (`loyalty.10_percent_coupon_communication`), whose template
        `loyalty.mail_template_loyalty_card` attaches the QWeb report
        `loyalty.report_loyalty_card`. Creating a card there renders a PDF inside the demo
        load, which hangs indefinitely on an installation without a working wkhtmltopdf
        (observed, not supposed). `3_cabinets_plus_1_free` carries no `loyalty.mail` at all,
        so card creation stays inert.

        Dates stay relative to the installation day through the `DateTime` /
        `relativedelta` helpers injected in the eval context by
        odoo.tools.convert._get_idref, so the set never goes stale.
    -->

    <!-- ================================================================
         Default configuration, carried by a core demo program. The two
         mail.template records referenced below (mail_template_card_
         expiry_reminder / mail_template_card_balance_reminder) are
         functional data, not demo: they live in
         data/mail_template_data.xml, loaded before this file regardless
         of demo being enabled, since mail_template_id is required on
         both line models and no other template ships with the module.
         ================================================================ -->

    <record id="program_reminder_line_expiry" model="loyalty.program.reminder.line">
        <field name="program_id" ref="loyalty.3_cabinets_plus_1_free"/>
        <field name="sequence">10</field>
        <field name="trigger_type">before_expiry</field>
        <field name="days_before">7</field>
        <field name="mail_template_id" ref="mail_template_card_expiry_reminder"/>
    </record>

    <record id="program_reminder_line_last_use" model="loyalty.program.reminder.line">
        <field name="program_id" ref="loyalty.3_cabinets_plus_1_free"/>
        <field name="sequence">20</field>
        <field name="trigger_type">points_remaining</field>
        <field name="points_remaining">1</field>
        <field name="mail_template_id" ref="mail_template_card_balance_reminder"/>
    </record>

    <!-- ================================================================
         Cards. Those that do not set `reminder_line_ids` inherit the two
         program lines above through the stored compute, which is itself
         what the copy mechanism has to show.
         ================================================================ -->

    <!-- Expiry within the 7-day window: the next cron pass reminds this one. -->
    <record id="card_expiring_soon" model="loyalty.card">
        <field name="program_id" ref="loyalty.3_cabinets_plus_1_free"/>
        <field name="partner_id" ref="base.res_partner_address_1"/>
        <field name="points">4</field>
        <field name="expiration_date" eval="(DateTime.today() + relativedelta(days=5)).strftime('%Y-%m-%d')"/>
    </record>

    <!--
        Reminder already sent. `reminder_line_ids` is given as an empty list so the stored
        compute does not copy the program lines over the two explicit lines below, which
        need their own xml_ids: the deactivated one is referenced by the chatter trace.
    -->
    <record id="card_reminder_already_sent" model="loyalty.card">
        <field name="program_id" ref="loyalty.3_cabinets_plus_1_free"/>
        <field name="partner_id" ref="base.res_partner_address_2"/>
        <field name="points">1</field>
        <field name="expiration_date" eval="(DateTime.today() + relativedelta(days=60)).strftime('%Y-%m-%d')"/>
        <field name="reminder_line_ids" eval="[]"/>
    </record>

    <record id="card_reminder_line_sent_balance" model="loyalty.card.reminder.line">
        <field name="card_id" ref="card_reminder_already_sent"/>
        <field name="sequence">10</field>
        <field name="trigger_type">points_remaining</field>
        <field name="points_remaining">1</field>
        <field name="mail_template_id" ref="mail_template_card_balance_reminder"/>
        <field name="active" eval="False"/>
    </record>

    <record id="card_reminder_line_pending_expiry" model="loyalty.card.reminder.line">
        <field name="card_id" ref="card_reminder_already_sent"/>
        <field name="sequence">20</field>
        <field name="trigger_type">before_expiry</field>
        <field name="days_before">7</field>
        <field name="mail_template_id" ref="mail_template_card_expiry_reminder"/>
    </record>

    <record id="card_reminder_message_sent_balance" model="mail.message">
        <field name="model">loyalty.card</field>
        <field name="res_id" eval="ref('card_reminder_already_sent')"/>
        <field name="message_type">notification</field>
        <field name="subtype_id" ref="mt_card_reminder_sent"/>
        <field name="author_id" ref="base.partner_root"/>
        <field name="body" eval="'reminder_line_id=%s' % ref('card_reminder_line_sent_balance')"/>
    </record>

    <!-- Card-level override: threshold raised to 3, where the program says 1. -->
    <record id="card_custom_threshold" model="loyalty.card">
        <field name="program_id" ref="loyalty.3_cabinets_plus_1_free"/>
        <field name="partner_id" ref="base.res_partner_address_3"/>
        <field name="points">6</field>
        <field name="reminder_line_ids" eval="[]"/>
    </record>

    <record id="card_reminder_line_custom_threshold" model="loyalty.card.reminder.line">
        <field name="card_id" ref="card_custom_threshold"/>
        <field name="sequence">10</field>
        <field name="trigger_type">points_remaining</field>
        <field name="points_remaining">3</field>
        <field name="mail_template_id" ref="mail_template_card_balance_reminder"/>
    </record>

    <!--
        No expiry date at all: the `before_expiry` line stays silent and raises nothing,
        which is what makes the module usable without loyalty_expiration_management.
    -->
    <record id="card_without_expiry_date" model="loyalty.card">
        <field name="program_id" ref="loyalty.3_cabinets_plus_1_free"/>
        <field name="partner_id" ref="base.res_partner_address_13"/>
        <field name="points">5</field>
    </record>

    <!-- Exhausted and already expired: neither trigger can ever fire on it. -->
    <record id="card_exhausted_and_expired" model="loyalty.card">
        <field name="program_id" ref="loyalty.3_cabinets_plus_1_free"/>
        <field name="partner_id" ref="base.res_partner_address_14"/>
        <field name="points">0</field>
        <field name="expiration_date" eval="(DateTime.today() - relativedelta(days=15)).strftime('%Y-%m-%d')"/>
    </record>

</odoo>
