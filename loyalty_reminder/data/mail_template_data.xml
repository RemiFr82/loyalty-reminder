<odoo noupdate="1">

    <!--
        FUNCTIONAL DATA OF loyalty_reminder.

        The module ships no mail.template of its own in the `loyalty` core: these two are
        what `mail_template_id` (required on both `loyalty.program.reminder.line` and
        `loyalty.card.reminder.line`) actually points to. Without them the module cannot
        send a single reminder: this is configuration the feature depends on, not demo
        data, hence `noupdate="1"`: a template customised by the end user must survive a
        module update untouched, exactly as the core does for its own `mail.template`
        records (e.g. `sale.email_template_edi_sale`, `loyalty.mail_template_loyalty_card`).
    -->

    <record id="mail_template_card_expiry_reminder" model="mail.template">
        <field name="name">Loyalty Card: Expiry Reminder</field>
        <field name="model_id" ref="loyalty.model_loyalty_card"/>
        <field name="subject">Your card expires soon</field>
        <field name="partner_to">{{ object._get_mail_partner().id }}</field>
        <field name="lang">{{ object._get_mail_partner().lang }}</field>
        <field name="description">Sent to the holder of a loyalty card whose expiry date is approaching.</field>
        <field name="body_html" type="html">
            <div style="margin:0px; padding:0px; font-size:13px">
                <p>Hello <t t-out="object.partner_id.name or ''">Willie Burke</t>,</p>
                <p>
                    Your card <t t-out="object.code or ''">044fd3a2</t>
                    (<t t-out="object.program_id.name or ''">Buy 3 large cabinets, get one for free</t>)
                    expires on <t t-out="format_date(object.expiration_date) or ''">05/05/2026</t>.
                </p>
                <p>There is still time to use it.</p>
            </div>
        </field>
    </record>

    <record id="mail_template_card_balance_reminder" model="mail.template">
        <field name="name">Loyalty Card: Remaining Balance Reminder</field>
        <field name="model_id" ref="loyalty.model_loyalty_card"/>
        <field name="subject">Your card is running low</field>
        <field name="partner_to">{{ object._get_mail_partner().id }}</field>
        <field name="lang">{{ object._get_mail_partner().lang }}</field>
        <field name="description">Sent to the holder of a loyalty card whose remaining balance has reached the configured threshold.</field>
        <field name="body_html" type="html">
            <div style="margin:0px; padding:0px; font-size:13px">
                <p>Hello <t t-out="object.partner_id.name or ''">Ron Gibson</t>,</p>
                <p>
                    Your card <t t-out="object.code or ''">044fd3a2</t>
                    (<t t-out="object.program_id.name or ''">Buy 3 large cabinets, get one for free</t>)
                    only has <t t-out="object.points or 0">1</t> left.
                </p>
                <p>Renew it whenever you are ready.</p>
            </div>
        </field>
    </record>

</odoo>
