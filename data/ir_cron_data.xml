<odoo noupdate="1">

    <record id="ir_cron_loyalty_reminder" model="ir.cron">
        <field name="name">Loyalty Reminder: send threshold/expiry emails</field>
        <field name="model_id" ref="loyalty.model_loyalty_card"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
